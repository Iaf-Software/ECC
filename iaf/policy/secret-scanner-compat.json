{
  "version": 1,
  "owner": "IAF",
  "purpose": "Classify ECC detector-regex files as SECURITY_DETECTION_REGEX rather than live secrets, without globally ignoring ECC directories.",
  "neverGloballyIgnoreEccDirectories": true,
  "classes": [
    "REAL_SECRET",
    "TEST_FIXTURE",
    "SECURITY_DETECTION_REGEX",
    "GENERATED_ECC_SECURITY_RULE",
    "FALSE_POSITIVE"
  ],
  "detectorFingerprints": [
    {
      "class": "SECURITY_DETECTION_REGEX",
      "pathSuffix": "hooks/before-submit-prompt.js",
      "mustContain": "sk-[a-zA-Z0-9]{20,}"
    },
    {
      "class": "SECURITY_DETECTION_REGEX",
      "pathSuffix": "skills/continuous-learning-v2/hooks/observe.sh",
      "mustContain": "_SECRET_RE = re.compile("
    },
    {
      "class": "SECURITY_DETECTION_REGEX",
      "pathSuffix": "lib/mcp-inventory/canonical-mcp.js",
      "mustContain": "SECRET_KEY_PATTERN"
    },
    {
      "class": "SECURITY_DETECTION_REGEX",
      "pathSuffix": "lib/memory-vault-format.js",
      "mustContain": "SECRET_PATTERNS"
    },
    {
      "class": "GENERATED_ECC_SECURITY_RULE",
      "pathSuffix": "agents/ecc-opensource-forker.md",
      "mustContain": "SECRET_KEY=change-me-to-a-random-string"
    },
    {
      "class": "GENERATED_ECC_SECURITY_RULE",
      "pathSuffix": "rules/java-security.mdc",
      "mustContain": "API_KEY = \"sk-abc123...\""
    }
  ]
}
